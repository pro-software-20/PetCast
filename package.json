{
  "name": "petcast-stage1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PetCast Stage 1 desktop companion shell",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:ai": "node --env-file=.env.local scripts/dev-ai.mjs",
    "dev:ai:processes": "concurrently -k \"node dist-server/server/main.js\" \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:8787 http://127.0.0.1:5173 && electron .\"",
    "dev:prompt-api": "pnpm run build:server && node dist-server/server/main.js",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/build-preload.mjs",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "tsc -b && vite build --base=./ --outDir=dist && npm run build:electron && npm run build:server",
    "start": "electron .",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test:contracts": "node --test tests/*.test.mjs",
    "check:codex": "npm run build:electron && node scripts/check-codex-usage.mjs",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "test:ui": "npm run build && node scripts/test-usage-ui.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "28.3.3",
    "typescript": "5.7.3",
    "vite": "5.4.21",
    "wait-on": "8.0.1"
  }
}
