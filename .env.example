# Prompt optimization backend (server only; never expose these values to the renderer)
DEEPSEEK_API_KEY=
RATE_LIMIT_HASH_SECRET=
DEEPSEEK_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=8787
PROMPT_RATE_LIMIT_STATE_PATH=work/prompt-rate-limits.json
PETCAST_TRUST_PROXY=0

# Optional anonymous beta limits
PROMPT_LIMIT_INSTALL_MINUTE=5
PROMPT_LIMIT_INSTALL_DAY=50
PROMPT_LIMIT_IP_MINUTE=20
PROMPT_LIMIT_IP_DAY=200
PROMPT_LIMIT_GLOBAL_DAY=1000

# Electron client (the public deployment must use an HTTPS URL)
PETCAST_PROMPT_API_URL=http://127.0.0.1:8787

# Developer-only fallback. Public builds should keep this disabled and use Continue with ChatGPT.
PETCAST_EXPERIMENTAL_LOCAL_CODEX_AUTH=0
